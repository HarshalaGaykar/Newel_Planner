NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=7d
PORT=4001
FRONTEND_URL=https://your-frontend-domain.example.com
# HTTPS cross-site deployments need SameSite=None and Secure=true.
# Temporary HTTP same-site deployments can use COOKIE_SAME_SITE=lax and COOKIE_SECURE=false.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM=no-reply@example.com
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
