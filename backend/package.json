{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- node dist/src/main.js",
    "prisma:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "prisma:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:seed:dev": "dotenv -e .env.development -- ts-node prisma/seed.ts",
    "prisma:seed:permissions:dev": "dotenv -e .env.development -- ts-node prisma/seed-role-permissions-only.ts",
    "prisma:seed:permissions:prod": "dotenv -e .env.production -- ts-node prisma/seed-role-permissions-only.ts",
    "prisma:seed:check:dev": "dotenv -e .env.development -- ts-node prisma/check-seed-status.ts",
    "prisma:seed:check:prod": "dotenv -e .env.production -- ts-node prisma/check-seed-status.ts",
    "prisma:seed:menus:dev": "dotenv -e .env.development -- ts-node prisma/seed-menus.ts",
    "prisma:seed:menus:prod": "dotenv -e .env.production -- ts-node prisma/seed-menus.ts",
    "prisma:seed:departments:dev": "dotenv -e .env.development -- ts-node prisma/seed-departments.ts",
    "prisma:seed:departments:prod": "dotenv -e .env.production -- ts-node prisma/seed-departments.ts",
    "prisma:seed:skills:dev": "dotenv -e .env.development -- ts-node prisma/seed-skills.ts",
    "prisma:seed:skills:prod": "dotenv -e .env.production -- ts-node prisma/seed-skills.ts",
    "prisma:seed:timesheet-activities:dev": "dotenv -e .env.development -- ts-node prisma/seed-timesheet-activity-master.ts",
    "prisma:seed:timesheet-activities:prod": "dotenv -e .env.production -- ts-node prisma/seed-timesheet-activity-master.ts",
    "prisma:seed:currencies:dev": "dotenv -e .env.development -- ts-node prisma/seed-currencies.ts",
    "prisma:seed:currencies:prod": "dotenv -e .env.production -- ts-node prisma/seed-currencies.ts",
    "prisma:seed:company:dev": "dotenv -e .env.development -- ts-node prisma/seed-company.ts",
    "prisma:seed:company:prod": "dotenv -e .env.production -- ts-node prisma/seed-company.ts",
    "prisma:seed:stages:dev": "dotenv -e .env.development -- ts-node prisma/seed-delivery-stages.ts",
    "prisma:seed:stages:prod": "dotenv -e .env.production -- ts-node prisma/seed-delivery-stages.ts",
    "prisma:seed:priorities:dev": "dotenv -e .env.development -- ts-node prisma/seed-priority-masters.ts",
    "prisma:seed:priorities:prod": "dotenv -e .env.production -- ts-node prisma/seed-priority-masters.ts",
    "prisma:seed:leave-types:dev": "dotenv -e .env.development -- ts-node prisma/seed-leave-types.ts",
    "prisma:seed:leave-types:prod": "dotenv -e .env.production -- ts-node prisma/seed-leave-types.ts",
    "prisma:seed:leave-types-paid-only:dev": "dotenv -e .env.development -- ts-node prisma/seed-leave-types-paid-only.ts",
    "prisma:seed:leave-types-paid-only:prod": "dotenv -e .env.production -- ts-node prisma/seed-leave-types-paid-only.ts",
    "prisma:seed:shifts:dev": "dotenv -e .env.development -- ts-node prisma/seed-shifts.ts",
    "prisma:seed:shifts:prod": "dotenv -e .env.production -- ts-node prisma/seed-shifts.ts",
    "prisma:seed:workflows:dev": "dotenv -e .env.development -- ts-node prisma/seed-workflow-templates.ts",
    "prisma:seed:workflows:prod": "dotenv -e .env.production -- ts-node prisma/seed-workflow-templates.ts",
    "prisma:seed:admin-config:dev": "dotenv -e .env.development -- ts-node prisma/seed-admin-configuration.ts",
    "prisma:seed:admin-config:prod": "dotenv -e .env.production -- ts-node prisma/seed-admin-configuration.ts",
    "prisma:backfill:daily-effort:dev": "dotenv -e .env.development -- ts-node prisma/backfill-task-daily-effort.ts",
    "prisma:backfill:daily-effort:prod": "dotenv -e .env.production -- ts-node prisma/backfill-task-daily-effort.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "openapi:export": "nest build && dotenv -e .env.development -- node dist/src/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.2.1",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "dayjs": "^1.11.20",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "prisma": "6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
