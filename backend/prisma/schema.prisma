model AttendanceRegularization {
  id                   String               @id @default(uuid())
  userId               String
  attendanceId         String?
  date                 DateTime             @db.Timestamptz(3)
  requestedIn          DateTime?            @db.Timestamptz(3)
  requestedInTimeZone  String?
  requestedOut         DateTime?            @db.Timestamptz(3)
  requestedOutTimeZone String?
  reason               RegularizationReason
  remarks              String?
  status               RegularizationStatus @default(PENDING)
  approverId           String?
  approvedAt           DateTime?
  // Approver's note on the decision — distinct from `remarks`, which is the
  // requester's justification. Surfaced in the decision email.
