generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                     @id @default(uuid())
  email                   String                     @unique
  employeeCode            String?                    @unique
  password                String
  firstName               String?
  lastName                String?
  isActive                Boolean                    @default(true)
  roleId                  String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  failedAttempts          Int                        @default(0)
  employmentStatus        EmploymentStatus           @default(ACTIVE)
  departmentId            String?
  baseCostPerHour         Float                      @default(0)
  billingRatePerHour      Float                      @default(0)
  reportingAuthorityId    String?
  locationId              String?
  shiftId                 String?
  mobile                  String?
  dateOfJoining           DateTime?
  designation             String?
  grade                   String?
  avatarUrl               String?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  allocations             Allocation[]
  auditLogs               AuditLog[]
  compOffs                CompOff[]
  leaves                  Leave[]
  leaveBalances           LeaveBalance[]
  refreshTokens           RefreshToken[]
  assignedTasks           Task[]                     @relation("TaskAssignee")
  createdTasks            Task[]                     @relation("TaskCreatedBy")
  assignedTickets         Ticket[]                   @relation("TicketAssignee")
  taskAssignments         TaskAssignee[]             @relation("UserTaskAssignments")
  ticketAssignments       TicketAssignee[]           @relation("UserTicketAssignments")
  approvingTimesheets     Timesheet[]                @relation("TimesheetApprover")
  timesheets              Timesheet[]
  department              Department?                @relation(fields: [departmentId], references: [id])
  reportingAuthority      User?                      @relation("ReportingHierarchy", fields: [reportingAuthorityId], references: [id])
  subordinates            User[]                     @relation("ReportingHierarchy")
  role                    Role                       @relation(fields: [roleId], references: [id])
  skills                  UserSkill[]
  attendance              Attendance[]
  regularizations         AttendanceRegularization[]
  approvedRegularizations AttendanceRegularization[] @relation("RegularizationApprover")
  location                Location?                  @relation(fields: [locationId], references: [id])
  shift                   Shift?                     @relation(fields: [shiftId], references: [id])
  pmProjects              Project[]                  @relation("ProjectPM")
  createdProjects         Project[]                  @relation("ProjectCreatedBy")
  addedExpenses           ProjectExpense[]           @relation("ExpenseAdder")
  generatedTmRuns         TmBillingRun[]             @relation("TmRunGenerator")

  passwordResetOtps         PasswordResetOtp[]
  reportSettingsUpdated     DeliveryReportSettings[]      @relation("ReportSettingsUpdatedBy")
  reportSends               DeliveryReportSend[]          @relation("ReportSentBy")

  workflowRequests          WorkflowInstance[]            @relation("WorkflowRequester")
  workflowActions           WorkflowActionLog[]           @relation("WorkflowActor")
  notifications             Notification[]
  notificationPrefs         NotificationPreference[]
  emailLogs                 EmailLog[]                    @relation("EmailLogSubjectUser")
  createdSpokespersons      Spokesperson[]                @relation("SpokespersonCreatedBy")
  updatedSpokespersons      Spokesperson[]                @relation("SpokespersonUpdatedBy")
  assetConfirmations        AssetAllocationConfirmation[] @relation("AssetConfirmationRA")
  confirmedAssetAllocations AssetAllocationConfirmation[] @relation("AssetConfirmationConfirmedBy")
  projectStatusCcLinks      ProjectStatusCcUser[]

  // Admin Config Relations
  updatedConfigs   AdminConfig[]
  lockedTimesheets TimesheetLockPeriod[]

  // Backdated Timesheet Approval
  backdatedRequests    BackdatedTimesheetRequest[]
  backdatedApprovals   BackdatedTimesheetRequest[] @relation("BackdatedApprover")
  demands              Demand[]                    @relation("DemandRequester")
  demandComments       DemandComment[]
  crRequests           ChangeRequest[]             @relation("CRRequester")
  crComments           CRComment[]
  uploadedDocuments    Document[]
  createdBaselines     Baseline[]                  @relation("BaselineCreator")
  ownedRisks           Risk[]                      @relation("RiskOwner")
  ownedIssues          Issue[]                     @relation("IssueOwner")
  raisedIssues         Issue[]                     @relation("IssueRaiser")
  ownedDeps            Dependency[]                @relation("DependencyOwner")
  capacitySnapshots    CapacitySnapshot[]
  trainingSessions     TrainingSession[]           @relation("SessionTrainer")
  trainingEnrollments  TrainingEnrollment[]
  trainingCertificates TrainingCertificate[]
  trainingFeedbacks    TrainingFeedback[]

  createdQuestionBanks QuestionBank[]
  createdTests         Test[]
  testAttempts         TestAttempt[]
  testAssignments      TestAssignment[]

  // QA Test Management
  testSuitesCreated TestSuite[]     @relation("TestSuiteCreatedBy")
  testCasesCreated  TestCase[]      @relation("TestCaseCreatedBy")
  testCasesAssigned TestCase[]      @relation("TestCaseAssignedTo")
  testRunsCreated   TestRun[]       @relation("TestRunCreatedBy")
  testExecutions    TestExecution[] @relation("TestExecutedBy")
  deployments       Deployment[]    @relation("UserDeployments")

  // Assets
  allocatedAssets      Asset[]        @relation("AssetAllocatedTo")
  usedAssets           Asset[]        @relation("AssetCurrentlyUsedBy")
  recordedAssetHistory AssetHistory[] @relation("AssetHistoryRecordedBy")

  // Employee Maturity
  maturityRecord           EmployeeMaturity?         @relation("EmployeeMaturityUser")
  maturityRecordsCreated   EmployeeMaturity[]        @relation("EmployeeMaturityCreatedBy")
  maturityRecordsUpdated   EmployeeMaturity[]        @relation("EmployeeMaturityUpdatedBy")
  maturityHistory          EmployeeMaturityHistory[] @relation("EmployeeMaturityHistoryUser")
  maturityHistoryCreatedBy EmployeeMaturityHistory[] @relation("EmployeeMaturityHistoryCreatedBy")
  maturityHistoryUpdatedBy EmployeeMaturityHistory[] @relation("EmployeeMaturityHistoryUpdatedBy")

  // Task Type Master
  taskTypesCreated         TaskTypeMaster[]        @relation("TaskTypeMasterCreatedBy")
  taskTypesUpdated         TaskTypeMaster[]        @relation("TaskTypeMasterUpdatedBy")
  taskActivitiesCreated    TaskActivityMaster[]    @relation("TaskActivityMasterCreatedBy")
  taskActivitiesUpdated    TaskActivityMaster[]    @relation("TaskActivityMasterUpdatedBy")
  taskSubActivitiesCreated TaskSubActivityMaster[] @relation("TaskSubActivityMasterCreatedBy")
  taskSubActivitiesUpdated TaskSubActivityMaster[] @relation("TaskSubActivityMasterUpdatedBy")

  approvedLeaves Leave[] @relation("LeaveApprover")

  // Todo List / Activities
  createdActivities   Activity[]         @relation("ActivityCreatedBy")
  activityAssignments ActivityAssignee[]
  activityActions     ActivityAction[]   @relation("ActivityActionActor")

  // Recurring todo series
  createdActivityRecurrences    ActivityRecurrence[]         @relation("ActivityRecurrenceCreatedBy")
  activityRecurrenceAssignments ActivityRecurrenceAssignee[]

  // Timesheet bulk upload
  bulkUploadBatches   BulkUploadBatch[] @relation("BulkUploadEmployee")
  bulkUploadsUploaded BulkUploadBatch[] @relation("BulkUploadUploader")

  // WBS upload
  taskUploadBatchesUploaded TaskUploadBatch[] @relation("TaskUploadBatchUploader")

  // Task Board bulk upload
  taskBulkUploadsUploaded TaskBulkUploadBatch[] @relation("TaskBulkUploadUploader")

  @@index([roleId])
  @@index([departmentId])
  @@index([email])
}

model Attendance {
  id               String                     @id @default(uuid())
  userId           String
  date             DateTime                   @default(now()) @db.Timestamptz(3)
  checkIn          DateTime?                  @db.Timestamptz(3)
  checkInTimeZone  String?
  checkOut         DateTime?                  @db.Timestamptz(3)
  checkOutTimeZone String?
  status           String                     @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT
  remarks          String?
  isWfh            Boolean                    @default(false)
  overtimeHours    Float                      @default(0)
  shiftId          String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift            Shift?                     @relation(fields: [shiftId], references: [id])
  regularizations  AttendanceRegularization[]

  @@index([userId])
  @@index([date])
}

model Department {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  businessUnitId  String?
  costCenterId    String?
  parentId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  businessUnit    BusinessUnit?    @relation(fields: [businessUnitId], references: [id])
  costCenter      CostCenter?      @relation("DeptDefaultCC", fields: [costCenterId], references: [id])
  costCenters     CostCenter[]     @relation("CCBelongsToDept")
  parent          Department?      @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[]     @relation("DeptHierarchy")
  demands         Demand[]
  testAssignments TestAssignment[]
}

model Skill {
  id               String                 @id @default(uuid())
  name             String                 @unique
  description      String?
  categoryId       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  category         SkillCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taskSkills       TaskSkill[]
  ticketSkills     TicketSkill[]
  users            UserSkill[]
  freelancerSkills FreelancerSkill[]
  trainingPrograms TrainingProgramSkill[]

  @@index([categoryId])
}

model SkillCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      Skill[]
}

model UserSkill {
  userId    String
  skillId   String
  createdAt DateTime @default(now())
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  permissions     RolePermission[]
  users           User[]
  testAssignments TestAssignment[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  menus       MenuPermission[]
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  dataScope    DataScope  @default(OWN)
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  otpHash    String
  tokenHash  String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  module    String
  entityId  String?
  userId    String?
  reason    String?
  before    Json?
  after     Json?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model Menu {
  id          String           @id @default(uuid())
  name        String
  path        String           @unique
  icon        String?
  order       Int              @default(0)
  isActive    Boolean          @default(true)
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  parent      Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    Menu[]           @relation("MenuHierarchy")
  permissions MenuPermission[]
}

model MenuPermission {
  menuId       String
  permissionId String
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([menuId, permissionId])
}

model Client {
  id             String          @id @default(uuid())
  clientCode     String          @unique
  name           String
  gstin          String?
  pan            String?
  email          String?
  phone          String?
  address        String?
  contactPerson  String?
  currencyId     String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  currency       Currency?       @relation(fields: [currencyId], references: [id])
  projects       Project[]
  clientPOs      ClientPO[]
  providedAssets Asset[]
  spokespersons  Spokesperson[]
  contacts       ClientContact[]
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  email       String
  designation String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectLinks ProjectClientContact[]

  @@unique([clientId, email])
  @@index([clientId])
  @@index([isActive])
}

enum ProjectContactRole {
  TO
  CC
}

model ProjectClientContact {
  id              String             @id @default(uuid())
  projectId       String
  clientContactId String
  role            ProjectContactRole @default(TO)
  createdAt       DateTime           @default(now())

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientContactId])
  @@index([clientContactId])
  @@index([projectId])
}

model ProjectStatusCcUser {
  id        String             @id @default(uuid())
  projectId String
  userId    String
  role      ProjectContactRole @default(CC)
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

model Project {
  id                 String                 @id @default(uuid())
  name               String
  description        String?
  type               ProjectType
  startDate          DateTime
  endDate            DateTime?
  status             ProjectStatus          @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  projectCode        String?                @unique
  clientId           String?
  isInternal         Boolean                @default(false)
  methodology        Methodology            @default(AGILE)
  pmId               String?
  budgetHours        Float?
  budgetCost         Float?
  revenue            Float?
  slaType            String?
  profitCenterId     String?
  currencyId         String?
  billingModel       BillingModel           @default(MILESTONE)
  createdById        String?
  allocations        Allocation[]
  clientPOs          ClientPO[]
  milestones         Milestone[]
  tasks              Task[]
  taskUploadBatches  TaskUploadBatch[]
  tickets            Ticket[]
  timesheets         Timesheet[]
  timesheetEntries   TimesheetEntry[]
  client             Client?                @relation(fields: [clientId], references: [id])
  pm                 User?                  @relation("ProjectPM", fields: [pmId], references: [id])
  createdBy          User?                  @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  profitCenter       ProfitCenter?          @relation(fields: [profitCenterId], references: [id])
  currency           Currency?              @relation(fields: [currencyId], references: [id])
  demand             Demand?
  changeRequests     ChangeRequest[]
  sprints            Sprint[]
  risks              Risk[]
  issues             Issue[]
  dependencies       Dependency[]
  retainerConfig     RetainerConfig?
  expenses           ProjectExpense[]
  tmBillingRuns      TmBillingRun[]
  directInvoices     Invoice[]              @relation("InvoiceProject")
  baselines          Baseline[]
  deliveryItems      DeliveryItem[]
  testSuites         TestSuite[]
  testRuns           TestRun[]
  deployments        Deployment[]
  assets             Asset[]                @relation("AssetProject")
  clientContactLinks ProjectClientContact[]
  statusCcUsers      ProjectStatusCcUser[]
  reportSettings     DeliveryReportSettings?
  reportSends        DeliveryReportSend[]

  @@index([createdById])
}

model Task {
  id               String           @id @default(uuid())
  title            String
  description      String?
  status           String           @default("BACKLOG")
  priority         String           @default("MEDIUM")
  estimatedEffort  Float?
  actualEffort     Float            @default(0)
  startDate        DateTime?
  endDate          DateTime?
  projectId        String
  assigneeId       String?
  parentId         String?
  predecessorId    String?
  milestoneId      String?
  sprintId         String?
  storyPoints      Float?
  complexity       Int              @default(3)
  techStack        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  taskType         String?
  taskTypeMasterId String?
  isCritical       Boolean          @default(false)
  wbsLevel         String?
  plannedStart     DateTime?
  plannedEnd       DateTime?
  plannedHours     Float?
  // Derived effort spread over the task's working days — see daily-effort.util.ts
  dailyEffort      Float?
  // True when dailyEffort was typed by hand instead of being derived.
  dailyEffortOverride Boolean @default(false)
  workingDays      Int?
  progressPct      Float            @default(0)
  crId             String?
  phase            CRPhase?
  uploadBatchId    String?
  bulkUploadBatchId String?
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id])
  parent           Task?            @relation("TaskHierarchy", fields: [parentId], references: [id])
  subTasks         Task[]           @relation("TaskHierarchy")
  predecessor      Task?            @relation("TaskDependencies", fields: [predecessorId], references: [id])
  successors       Task[]           @relation("TaskDependencies")
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest    ChangeRequest?   @relation(fields: [crId], references: [id])
  skills           TaskSkill[]
  entries          TimesheetEntry[]
  ticketId         String?
  ticket           Ticket?          @relation(fields: [ticketId], references: [id])
  sprint           Sprint?          @relation(fields: [sprintId], references: [id])
  issues           Issue[]
  deploymentId     String?
  deployment       Deployment?      @relation("DeploymentTasks", fields: [deploymentId], references: [id])
  dependenciesFrom Dependency[]     @relation("DependencyFrom")
  dependenciesTo   Dependency[]     @relation("DependencyTo")
  createdById      String?
  createdBy        User?            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  taskTypeMaster   TaskTypeMaster?  @relation(fields: [taskTypeMasterId], references: [id])
  taskAssignees    TaskAssignee[]
  uploadBatch      TaskUploadBatch? @relation("TaskUploadBatchTasks", fields: [uploadBatchId], references: [id])
  bulkUploadBatch  TaskBulkUploadBatch? @relation("TaskBulkUploadTasks", fields: [bulkUploadBatchId], references: [id])

  @@index([taskTypeMasterId])
  @@index([createdById])
  @@index([uploadBatchId])
  @@index([bulkUploadBatchId])
}

// Additional assignees for a Task (beyond the primary `assigneeId`).
model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation("UserTaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Sprint {
  id          String       @id @default(uuid())
  projectId   String
  name        String
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus @default(PLANNED)
  capacity    Float?
  velocity    Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  testRuns    TestRun[]
  deployments Deployment[] @relation("SprintDeployments")

  @@index([projectId])
  @@index([status])
}

model Baseline {
  id           String   @id @default(uuid())
  projectId    String
  version      Int
  label        String
  snapshotData Json
  createdById  String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("BaselineCreator", fields: [createdById], references: [id])

  @@unique([projectId, version])
  @@index([projectId])
}

model PredictionAudit {
  id              String   @id @default(uuid())
  module          String
  entityId        String
  features        Json
  predictedValue  Float
  actualValue     Float?
  userAdjustment  Float?
  confidenceScore Float?
  createdAt       DateTime @default(now())
}

model Ticket {
  id              String           @id @default(uuid())
  title           String
  description     String?
  status          String           @default("OPEN")
  priority        String           @default("MEDIUM")
  type            String           @default("BUG")
  targetDate      DateTime?
  isSlaBreached   Boolean          @default(false)
  projectId       String
  assigneeId      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  actualEffort    Float            @default(0)
  complexity      String           @default("MEDIUM")
  techStack       String?
  assignee        User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skills          TicketSkill[]
  entries         TimesheetEntry[]
  issues          Issue[]
  deploymentId    String?
  deployment      Deployment?      @relation("DeploymentTickets", fields: [deploymentId], references: [id])
  tasks           Task[]
  testExecutions  TestExecution[]
  ticketAssignees TicketAssignee[]
}

// Additional assignees for a Ticket (beyond the primary `assigneeId`).
model TicketAssignee {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation("UserTicketAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

model Timesheet {
  id                String                      @id @default(uuid())
  userId            String?
  freelancerId      String?
  projectId         String?
  startDate         DateTime
  endDate           DateTime
  status            TimesheetStatus             @default(DRAFT)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  approverId        String?
  lastStatusChange  DateTime                    @default(now())
  rejectionRemarks  String?
  bulkUploadBatchId String?
  approver          User?                       @relation("TimesheetApprover", fields: [approverId], references: [id])
  project           Project?                    @relation(fields: [projectId], references: [id])
  user              User?                       @relation(fields: [userId], references: [id])
  freelancer        Freelancer?                 @relation(fields: [freelancerId], references: [id])
  entries           TimesheetEntry[]
  backdatedRequests BackdatedTimesheetRequest[]
  bulkUploadBatch   BulkUploadBatch?            @relation("BulkUploadCreatedTimesheet", fields: [bulkUploadBatchId], references: [id])

  @@unique([userId, startDate], name: "user_week")
  @@unique([freelancerId, projectId, startDate], name: "freelancer_project_week")
  @@index([approverId])
  @@index([freelancerId])
  @@index([bulkUploadBatchId])
}

model TimesheetActivityMaster {
  id          String            @id @default(uuid())
  taskType    TimesheetTaskType
  activity    String
  subActivity String
  meaning     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entries     TimesheetEntry[]

  @@unique([taskType, activity, subActivity])
  @@index([taskType])
}

model TimesheetEntry {
  id                      String                   @id @default(uuid())
  timesheetId             String
  projectId               String
  date                    DateTime
  hours                   Float
  description             String?
  taskType                TimesheetTaskType        @default(OBSERVATION)
  activityMasterId        String?
  taskSubActivityMasterId String?
  taskId                  String?
  ticketId                String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  endTime                 DateTime?
  startTime               DateTime?
  bulkUploadBatchId       String?
  activityMaster          TimesheetActivityMaster? @relation(fields: [activityMasterId], references: [id])
  taskSubActivity         TaskSubActivityMaster?   @relation("TimesheetEntrySubActivity", fields: [taskSubActivityMasterId], references: [id])
  project                 Project                  @relation(fields: [projectId], references: [id])
  task                    Task?                    @relation(fields: [taskId], references: [id])
  ticket                  Ticket?                  @relation(fields: [ticketId], references: [id])
  timesheet               Timesheet                @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  bulkUploadBatch         BulkUploadBatch?         @relation("BulkUploadEntry", fields: [bulkUploadBatchId], references: [id])

  @@index([timesheetId])
  @@index([projectId])
  @@index([activityMasterId])
  @@index([taskSubActivityMasterId])
  @@index([bulkUploadBatchId])
  @@index([taskId])
}

model BackdatedTimesheetRequest {
  id          String    @id @default(uuid())
  timesheetId String
  entryDate   DateTime
  userId      String
  reason      String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  approver    User?     @relation("BackdatedApprover", fields: [approverId], references: [id])

  @@index([timesheetId])
  @@index([userId])
  @@index([approverId])
}

// One row per timesheet bulk upload. Every entry it creates is tagged with its id,
// and every weekly timesheet it newly creates points back to it — so a rollback can
// delete ONLY the records this upload produced, never manual/pre-existing data.
model BulkUploadBatch {
  id            String    @id @default(uuid())
  userId        String // employee whose timesheet was filled
  uploadedById  String // actor who ran the upload
  fileName      String?
  importedCount Int       @default(0)
  skippedCount  Int       @default(0)
  errorCount    Int       @default(0)
  errors        Json?
  status        String    @default("COMPLETED") // COMPLETED | ROLLED_BACK
  createdAt     DateTime  @default(now())
  rolledBackAt  DateTime?

  user              User             @relation("BulkUploadEmployee", fields: [userId], references: [id])
  uploadedBy        User             @relation("BulkUploadUploader", fields: [uploadedById], references: [id])
  entries           TimesheetEntry[] @relation("BulkUploadEntry")
  createdTimesheets Timesheet[]      @relation("BulkUploadCreatedTimesheet")

  @@index([userId])
  @@index([uploadedById])
}

// One row per WBS upload. Every task it creates is tagged with its id, so an
// undo can delete ONLY the tasks this upload produced — never manual/pre-existing tasks.
model TaskUploadBatch {
  id            String    @id @default(uuid())
  projectId     String
  uploadedById  String // actor who ran the upload
  fileName      String?
  importedCount Int       @default(0)
  skippedCount  Int       @default(0)
  errorCount    Int       @default(0)
  errors        Json?
  status        String    @default("COMPLETED") // COMPLETED | ROLLED_BACK
  createdAt     DateTime  @default(now())
  rolledBackAt  DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("TaskUploadBatchUploader", fields: [uploadedById], references: [id])
  tasks      Task[]  @relation("TaskUploadBatchTasks")

  @@index([projectId])
  @@index([uploadedById])
}

// One row per Task Board bulk upload (global, can span multiple projects in one
// file). Every task it creates is tagged with its id, so an undo can delete ONLY
// the tasks this upload produced — never manual/pre-existing tasks. Kept separate
// from TaskUploadBatch (the per-project WBS import) since its history is global
// rather than project-scoped, and row-level errors are persisted (see BulkUploadBatch).
model TaskBulkUploadBatch {
  id            String    @id @default(uuid())
  uploadedById  String // actor who ran the upload
  fileName      String?
  importedCount Int       @default(0)
  skippedCount  Int       @default(0)
  errorCount    Int       @default(0)
  errors        Json?
  status        String    @default("COMPLETED") // COMPLETED | ROLLED_BACK
  createdAt     DateTime  @default(now())
  rolledBackAt  DateTime?

  uploadedBy User   @relation("TaskBulkUploadUploader", fields: [uploadedById], references: [id])
  tasks      Task[] @relation("TaskBulkUploadTasks")

  @@index([uploadedById])
}

model Leave {
  id                   String    @id @default(uuid())
