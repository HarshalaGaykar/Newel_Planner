  isRead    Boolean          @default(false)
  metadata  Json? // { entityType, entityId, link }
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType
  inApp  Boolean          @default(true)
  email  Boolean          @default(true)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ── DEMAND / INTAKE ──────────────────────────────────────────────────────────

enum DemandStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum DemandPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Demand {
  id                 String          @id @default(uuid())
  demandCode         String          @unique
  title              String
  description        String?
  requesterId        String
  departmentId       String?
  estimatedTimeline  DateTime?
  estimatedBudget    Float?
  priority           DemandPriority  @default(MEDIUM)
  attachmentUrl      String?
  status             DemandStatus    @default(DRAFT)
  reviewerRemarks    String?
  convertedProjectId String?         @unique
  workflowInstanceId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  requester          User            @relation("DemandRequester", fields: [requesterId], references: [id])
  department         Department?     @relation(fields: [departmentId], references: [id])
  convertedProject   Project?        @relation(fields: [convertedProjectId], references: [id])
  comments           DemandComment[]
}

model DemandComment {
  id        String   @id @default(uuid())
  demandId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

// -- CHANGE REQUESTS -----------------------------------------------------------

enum CRType {
  SCOPE
  BUDGET
  TIMELINE
  RESOURCE
  COMBINED
}

enum CRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IN_PROGRESS
  CLOSED
  DEFERRED
  ON_HOLD
}

enum CRPhase {
  REQUIREMENT
  DESIGN
  DEVELOPMENT
  TESTING
  UAT
  DEPLOYMENT
}

model ChangeRequest {
  id                 String      @id @default(uuid())
  crCode             String      @unique
  projectId          String
  title              String
  type               CRType
  description        String?
  impactedScope      String? // free text describing scope changes
  budgetDelta        Float? // +ve = increase, -ve = decrease
  timelineDeltaDays  Int? // number of days to extend endDate
  resourceChanges    Json? // [{ action: "ADD"|"REMOVE"|"CHANGE", resourceId, role, percentage }]
  status             CRStatus    @default(DRAFT)
  requesterId        String
  workflowInstanceId String?
  approvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  project            Project     @relation(fields: [projectId], references: [id])
  requester          User        @relation("CRRequester", fields: [requesterId], references: [id])
  comments           CRComment[]
  tasks              Task[]
}

model CRComment {
  id        String        @id @default(uuid())
  crId      String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  cr        ChangeRequest @relation(fields: [crId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])
}

enum DocType {
  BRD
  FRD
  SOW
  CONTRACT
  DESIGN
  TEST_SIGNOFF
  INVOICE
  NDA
  AGREEMENT
  PROPOSAL
  OTHER
}

model Document {
  id           String   @id @default(uuid())
  entityType   String // PROJECT, DEMAND, CR, VENDOR, FREELANCER, CLIENT
  entityId     String
  docType      DocType
  name         String
  originalName String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  version      Int      @default(1)
  isLatest     Boolean  @default(true)
  description  String?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([entityType, entityId, docType, isLatest])
}

// ── RISK REGISTER ─────────────────────────────────────────────────────────────

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  MITIGATED
  ACCEPTED
  CLOSED
}

model Risk {
  id          String          @id @default(uuid())
  projectId   String
  title       String
  description String?
  probability RiskProbability
  impact      RiskImpact
  riskScore   Int
  mitigation  String?
  contingency String?
  ownerId     String
  status      RiskStatus      @default(OPEN)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User            @relation("RiskOwner", fields: [ownerId], references: [id])

  @@index([projectId])
  @@index([status])
}

// ── ISSUE REGISTER ────────────────────────────────────────────────────────────

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model Issue {
  id          String        @id @default(uuid())
  projectId   String
  title       String
  description String?
  severity    IssueSeverity @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  ownerId     String
  raisedById  String
  eta         DateTime?
  resolvedAt  DateTime?
  escalatedAt DateTime?
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User          @relation("IssueOwner", fields: [ownerId], references: [id])
  raisedBy    User          @relation("IssueRaiser", fields: [raisedById], references: [id])
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id])
  ticketId    String?
  ticket      Ticket?       @relation(fields: [ticketId], references: [id])

  @@index([projectId])
  @@index([status])
}

// ── DEPENDENCY REGISTER ───────────────────────────────────────────────────────

enum DependencyType {
  INTERNAL
  EXTERNAL
}

enum DependencyStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  BLOCKED
}

model Dependency {
  id          String           @id @default(uuid())
  projectId   String
  title       String
  description String?
  type        DependencyType   @default(INTERNAL)
  fromTaskId  String?
  toTaskId    String?
  externalRef String?
  ownerId     String
  status      DependencyStatus @default(OPEN)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User             @relation("DependencyOwner", fields: [ownerId], references: [id])
  fromTask    Task?            @relation("DependencyFrom", fields: [fromTaskId], references: [id])
  toTask      Task?            @relation("DependencyTo", fields: [toTaskId], references: [id])

  @@index([projectId])
  @@index([status])
}

// ── CAPACITY PLANNING ─────────────────────────────────────────────────────────

model CapacitySnapshot {
  id             String   @id @default(uuid())
  userId         String
  month          Int // 1-12
  year           Int
  workingDays    Int
  dailyHours     Float    @default(8)
  availableHrs   Float
  allocatedHrs   Float    @default(0)
  billableHrs    Float    @default(0)
  utilizationPct Float    @default(0)
  benchDays      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month, year])
}

// ── TRAINING MODULE ───────────────────────────────────────────────────────────

enum TrainingType {
  INTERNAL
  EXTERNAL
  ONLINE
  CERTIFICATION
}

enum TrainingMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TrainingCategory {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  programs    TrainingProgram[]
}

model TrainingProgram {
  id           String                 @id @default(uuid())
  name         String
  description  String?
  type         TrainingType           @default(INTERNAL)
  categoryId   String?
  durationHrs  Float
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  category     TrainingCategory?      @relation(fields: [categoryId], references: [id])
  skills       TrainingProgramSkill[]
  sessions     TrainingSession[]
  certificates TrainingCertificate[]

  @@index([categoryId])
  @@index([type])
}

model TrainingProgramSkill {
  programId String
  skillId   String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill     Skill           @relation(fields: [skillId], references: [id])

  @@id([programId, skillId])
  @@index([skillId])
}

model TrainingSession {
  id           String                @id @default(uuid())
  programId    String
  title        String?
  startDate    DateTime
  endDate      DateTime
  mode         TrainingMode          @default(OFFLINE)
  venue        String?
  meetingUrl   String?
  maxCapacity  Int?
  trainerId    String?
  status       SessionStatus         @default(SCHEDULED)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  program      TrainingProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainer      User?                 @relation("SessionTrainer", fields: [trainerId], references: [id])
  enrollments  TrainingEnrollment[]
  certificates TrainingCertificate[]
  feedbacks    TrainingFeedback[]

  @@index([programId])
  @@index([startDate])
  @@index([status])
}

model TrainingEnrollment {
  id          String               @id @default(uuid())
  sessionId   String
  userId      String
  status      EnrollmentStatus     @default(ENROLLED)
  enrolledAt  DateTime             @default(now())
  completedAt DateTime?
  remarks     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  session     TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id])
  certificate TrainingCertificate?
  feedback    TrainingFeedback?

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([status])
}

model TrainingCertificate {
  id            String             @id @default(uuid())
  enrollmentId  String             @unique
  userId        String
  programId     String
  sessionId     String
  certificateNo String             @unique
  issuedAt      DateTime           @default(now())
  expiresAt     DateTime?
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id])
  program       TrainingProgram    @relation(fields: [programId], references: [id])
  session       TrainingSession    @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
}

model TrainingFeedback {
  id            String             @id @default(uuid())
  enrollmentId  String             @unique
  userId        String
  sessionId     String
  rating        Int
  trainerRating Int?
  contentRating Int?
  comments      String?
  createdAt     DateTime           @default(now())
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id])
  session       TrainingSession    @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

// ─── TEST MODULE ────────────────────────────────────────────────────────────

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AssignmentTarget {
  USER
  DEPARTMENT
  ROLE
}

model QuestionBank {
  id          String     @id @default(uuid())
  name        String
  description String?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  questions   Question[]
  tests       Test[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([createdById])
}

model Question {
  id             String          @id @default(uuid())
  bankId         String
  bank           QuestionBank    @relation(fields: [bankId], references: [id], onDelete: Cascade)
  text           String
  type           QuestionType    @default(SINGLE_CHOICE)
  options        Json // [{ id: string, text: string }]
  correctOptions Json // string[] of option ids
  explanation    String?
  difficulty     Difficulty      @default(MEDIUM)
  marks          Int             @default(1)
  tags           String[]
  testQuestions  TestQuestion[]
  answers        AttemptAnswer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([bankId])
  @@index([difficulty])
}

model Test {
  id           String           @id @default(uuid())
  title        String
  description  String?
  bankId       String?
  bank         QuestionBank?    @relation(fields: [bankId], references: [id])
  duration     Int // minutes
  totalMarks   Int
  passingMarks Int
  instructions String?
  status       TestStatus       @default(DRAFT)
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  questions    TestQuestion[]
  assignments  TestAssignment[]
  attempts     TestAttempt[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([createdById])
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  marks      Int? // overrides question.marks if set

  @@unique([testId, questionId])
  @@index([testId])
}

model TestAssignment {
  id           String           @id @default(uuid())
  testId       String
  test         Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  target       AssignmentTarget
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  roleId       String?
  role         Role?            @relation(fields: [roleId], references: [id])
  dueDate      DateTime?
  createdAt    DateTime         @default(now())

  @@index([testId])
  @@index([userId])
  @@index([departmentId])
  @@index([roleId])
}

model TestAttempt {
  id          String          @id @default(uuid())
  testId      String
  test        Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  status      AttemptStatus   @default(IN_PROGRESS)
  score       Float?
  percentage  Float?
  passed      Boolean?
  answers     AttemptAnswer[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([testId, userId])
  @@index([userId])
  @@index([status])
}

model AttemptAnswer {
  id              String      @id @default(uuid())
  attemptId       String
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id])
  selectedOptions Json // string[] of option ids
  isCorrect       Boolean?
  marksObtained   Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ── DELIVERY TRACKER ────────────────────────────────────────────────────────

enum DeliveryStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model DeliveryItem {
  id             String                @id @default(uuid())
  projectId      String
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  srNo           Int
  title          String
  owners         String?
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  uatReleaseDate DateTime?
  stageId        String?
  stage          DeliveryStageMaster?  @relation(fields: [stageId], references: [id])
  status         DeliveryStatus        @default(OPEN)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  remarks        DeliveryItemRemark[]
  history        DeliveryItemHistory[]

  @@index([projectId])
  @@index([stageId])
}

/// Canonical delivery lifecycle stages. Replaces the free-text `currentStage`
/// field, which had already drifted into casing variants ("UAT" vs "uat").
model DeliveryStageMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryItems DeliveryItem[]

  @@index([isActive])
}

model DeliveryItemRemark {
  id             String       @id @default(uuid())
  deliveryItemId String
  deliveryItem   DeliveryItem @relation(fields: [deliveryItemId], references: [id], onDelete: Cascade)
  date           DateTime
  content        String
  createdBy      String
  createdAt      DateTime     @default(now())

  @@index([deliveryItemId])
}

/// Per-project header fields for the delivery tracker report. Authored on the
/// tracker screen rather than at send time, so the same values feed the Excel
/// export, the preview and the emailed attachment.
model DeliveryReportSettings {
  id            String    @id @default(uuid())
  projectId     String    @unique
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate    DateTime?
  preparedBy    String?
  statusSummary String?
  updatedById   String?
  updatedBy     User?     @relation("ReportSettingsUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Audit trail of every delivery tracker report email — who sent it, who it was
/// prepared by, where it went, and whether it succeeded.
model DeliveryReportSend {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentById   String
  sentBy     User     @relation("ReportSentBy", fields: [sentById], references: [id])
  preparedBy String
  reportDate DateTime
  recipients String[]
  cc         String[]
  subject    String
  itemCount  Int      @default(0)
  status     String
  messageId  String?
  error      String?
  sentAt     DateTime @default(now())

  @@index([projectId])
  @@index([sentById])
}

model DeliveryItemHistory {
  id             String       @id @default(uuid())
  deliveryItemId String
  deliveryItem   DeliveryItem @relation(fields: [deliveryItemId], references: [id], onDelete: Cascade)
  field          String
  oldValue       String?
  newValue       String?
  changedBy      String
  changedAt      DateTime     @default(now())

  @@index([deliveryItemId])
}

// ── QA TEST MANAGEMENT ────────────────────────────────────────────────────────

enum TestCaseType {
  MANUAL
  AUTOMATED
}

enum TestCaseCategory {
  FUNCTIONAL
  UI
  API
  SECURITY
  PERFORMANCE
  OTHER
}

enum TestCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestCaseStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum TestRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum TestEnvironment {
  DEV
  STAGING
  UAT
  PRODUCTION
  OTHER
}

enum ExecutionResult {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

model TestSuite {
  id          String     @id @default(uuid())
  name        String
  description String?
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases       TestCase[]
  createdById String
  createdBy   User       @relation("TestSuiteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
}

model TestCase {
  id               String           @id @default(uuid())
  title            String
  description      String?
  preconditions    String?
  steps            Json             @default("[]")
  expectedResult   String?
  priority         TestCasePriority @default(MEDIUM)
  status           TestCaseStatus   @default(DRAFT)
  suiteId          String
  suite            TestSuite        @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  assignedToId     String?
  assignedTo       User?            @relation("TestCaseAssignedTo", fields: [assignedToId], references: [id])
  createdById      String
  createdBy        User             @relation("TestCaseCreatedBy", fields: [createdById], references: [id])
  executions       TestExecution[]
  type             TestCaseType     @default(MANUAL)
  category         TestCaseCategory @default(FUNCTIONAL)
  tags             String[]         @default([])
  automationId     String?
  requirementId    String?
  lastResult       ExecutionResult?
  lastActualResult String?
  lastExecutedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([suiteId])
  @@index([status])
}

model TestRun {
  id           String          @id @default(uuid())
  name         String
  description  String?
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId     String?
  sprint       Sprint?         @relation(fields: [sprintId], references: [id])
  status       TestRunStatus   @default(PLANNED)
  environment  TestEnvironment @default(STAGING)
  plannedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String
  createdBy    User            @relation("TestRunCreatedBy", fields: [createdById], references: [id])
  executions   TestExecution[]
  deploymentId String?
  deployment   Deployment?     @relation(fields: [deploymentId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
}

model TestExecution {
  id             String          @id @default(uuid())
  runId          String
  run            TestRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId         String
  case           TestCase        @relation(fields: [caseId], references: [id])
  result         ExecutionResult @default(NOT_RUN)
  actualResult   String?
  stepResults    Json? // format: [{ stepOrder: number, result: ExecutionResult, actual?: string }]
  notes          String?
  defectTicketId String?
  defectTicket   Ticket?         @relation(fields: [defectTicketId], references: [id])
  executedById   String?
  executedBy     User?           @relation("TestExecutedBy", fields: [executedById], references: [id])
  executedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  retestRequired Boolean         @default(false)

  @@unique([runId, caseId])
  @@index([runId])
  @@index([caseId])
}

// ── DEPLOYMENTS ───────────────────────────────────────────────────────────────

model Deployment {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment  TestEnvironment
  version      String?
  deployedAt   DateTime        @default(now())
  deployedById String
  deployedBy   User            @relation("UserDeployments", fields: [deployedById], references: [id])
  sprintId     String?
  sprint       Sprint?         @relation("SprintDeployments", fields: [sprintId], references: [id])
  status       String          @default("SUCCESS") // SUCCESS, FAILED
  notes        String?
  testRuns     TestRun[]
  tasks        Task[]          @relation("DeploymentTasks")
  tickets      Ticket[]        @relation("DeploymentTickets")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId])
  @@index([environment])
}

// ── ASSET MANAGEMENT ──────────────────────────────────────────────────────────

enum AssetType {
  HARDWARE
  SOFTWARE
  LICENSE
  LAPTOP
  CHARGER
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  IN_MAINTENANCE
  RETIRED
  LOST
}

model Asset {
  id             String      @id @default(uuid())
  assetTag       String      @unique // E.g. LPT-001
  name           String // E.g. MacBook Pro 16
  type           AssetType
  status         AssetStatus @default(AVAILABLE)
  serialNumber   String?
  vendor         String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?

  // Ownership
  isClientProvided Boolean @default(false)
  clientId         String?
  client           Client? @relation(fields: [clientId], references: [id])

  // Tracking
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  allocatedToId String?
  allocatedTo   User?   @relation("AssetAllocatedTo", fields: [allocatedToId], references: [id])

  currentlyUsedById String?
  currentlyUsedBy   User?   @relation("AssetCurrentlyUsedBy", fields: [currentlyUsedById], references: [id])

  // Client-side point of contact for this asset (only meaningful for client-provided assets)
  spokespersonId String?
  spokesperson   Spokesperson? @relation("AssetSpokesperson", fields: [spokespersonId], references: [id])

  // Project this asset is associated with
  projectId String?
  project   Project? @relation("AssetProject", fields: [projectId], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history AssetHistory[]

  @@index([type])
  @@index([status])
  @@index([clientId])
  @@index([allocatedToId])
  @@index([spokespersonId])
  @@index([projectId])
}

// Client-side point of contact. Created on the fly from the asset form's searchable
// combobox and reused across assets for the same client. Uniqueness of an active
// name per client (case-insensitive) is enforced in SpokespersonsService, which
// reactivates a soft-deleted match rather than creating a duplicate.
model Spokesperson {
  id          String   @id @default(uuid())
  name        String
  clientId    String
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client  @relation(fields: [clientId], references: [id])
  createdBy User?   @relation("SpokespersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("SpokespersonUpdatedBy", fields: [updatedById], references: [id])
  assets    Asset[] @relation("AssetSpokesperson")

  @@index([clientId])
  @@index([isActive])
}

// Monthly acknowledgement that a manager (TL/RA) has verified the asset allocations
// of their team (assets whose "currently used by" user reports to them). One row per
// reporting authority per period ("YYYY-MM"); drives the 1st/5th/7th/10th reminder
// escalation. Sends themselves are logged/deduped via EmailLog.
model AssetAllocationConfirmation {
  id                   String    @id @default(uuid())
  reportingAuthorityId String
  period               String // "YYYY-MM"
  status               String    @default("PENDING") // PENDING | CONFIRMED
  assetCount           Int       @default(0)
  confirmedAt          DateTime?
  confirmedById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  reportingAuthority User  @relation("AssetConfirmationRA", fields: [reportingAuthorityId], references: [id])
  confirmedBy        User? @relation("AssetConfirmationConfirmedBy", fields: [confirmedById], references: [id])

  @@unique([reportingAuthorityId, period])
  @@index([period])
  @@index([status])
}

model AssetHistory {
  id             String       @id @default(uuid())
  assetId        String
  action         String // ALLOCATED, REASSIGNED, RETURNED, MAINTENANCE, STATUS_CHANGE
  previousUserId String?
  newUserId      String?
  previousStatus AssetStatus?
  newStatus      AssetStatus?
  notes          String?
  recordedById   String
  createdAt      DateTime     @default(now())

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("AssetHistoryRecordedBy", fields: [recordedById], references: [id])

  @@index([assetId])
}

// ─── Employee Maturity ────────────────────────────────────────────────────────

model EmployeeMaturity {
  id                   String   @id @default(uuid())
  userId               String   @unique
  userName             String
  currentMaturityValue Float
  forTheMonth          DateTime
  isActive             Boolean  @default(true)
  remarks              String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedById          String?
  updatedAt            DateTime @updatedAt

  user      User                      @relation("EmployeeMaturityUser", fields: [userId], references: [id])
  createdBy User                      @relation("EmployeeMaturityCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                     @relation("EmployeeMaturityUpdatedBy", fields: [updatedById], references: [id])
  history   EmployeeMaturityHistory[]

  @@index([forTheMonth])
}

model EmployeeMaturityHistory {
  id                 String    @id @default(uuid())
  employeeMaturityId String
  userId             String
  userName           String
  maturityValue      Float
  forTheMonth        DateTime
  isActive           Boolean   @default(true)
  remarks            String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedById        String?
  updatedAt          DateTime?

  employeeMaturity EmployeeMaturity @relation(fields: [employeeMaturityId], references: [id])
  user             User             @relation("EmployeeMaturityHistoryUser", fields: [userId], references: [id])
  createdBy        User             @relation("EmployeeMaturityHistoryCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?            @relation("EmployeeMaturityHistoryUpdatedBy", fields: [updatedById], references: [id])

  @@unique([userId, forTheMonth])
  @@index([employeeMaturityId])
  @@index([forTheMonth])
}

// ─── Task Type Master ────────────────────────────────────────────────────────

model TaskTypeMaster {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  activities TaskActivityMaster[]
  tasks      Task[]
  createdBy  User?                @relation("TaskTypeMasterCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?                @relation("TaskTypeMasterUpdatedBy", fields: [updatedById], references: [id])

  @@index([isActive])
}

model TaskActivityMaster {
  id          String   @id @default(uuid())
  taskTypeId  String
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  taskType      TaskTypeMaster          @relation(fields: [taskTypeId], references: [id])
  subActivities TaskSubActivityMaster[]
  createdBy     User?                   @relation("TaskActivityMasterCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?                   @relation("TaskActivityMasterUpdatedBy", fields: [updatedById], references: [id])

  @@unique([taskTypeId, name])
  @@index([taskTypeId])
  @@index([isActive])
}

model TaskSubActivityMaster {
  id          String   @id @default(uuid())
  activityId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  activity         TaskActivityMaster @relation(fields: [activityId], references: [id])
  createdBy        User?              @relation("TaskSubActivityMasterCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?              @relation("TaskSubActivityMasterUpdatedBy", fields: [updatedById], references: [id])
  timesheetEntries TimesheetEntry[]   @relation("TimesheetEntrySubActivity")

  @@unique([activityId, name])
  @@index([activityId])
  @@index([isActive])
}

enum EmailLogStatus {
  SUCCESS
  FAILED
}

enum EmailKind {
  ATTENDANCE_CHECKIN_MISSING_EMPLOYEE
  ATTENDANCE_CHECKIN_MISSING_RA
  ATTENDANCE_CHECKIN_MISSING_HR_DIGEST
  ASSET_ALLOCATION_CONFIRMATION
  ATTENDANCE_REGULARIZATION_REQUEST
  ATTENDANCE_REGULARIZATION_DECISION
  LEAVE_REQUEST
  LEAVE_DECISION
  PROJECT_STATUS_REPORT
}

// Audit trail of outbound emails (success + detailed failure) and the source of
// send idempotency. Only SUCCESS rows carry a `dedupeKey`; FAILED rows leave it
// null so they remain retryable while duplicate successes are blocked by the
// unique constraint. Append-only — no updatedAt (matches AuditLog/Notification).
model EmailLog {
  id            String         @id @default(uuid())
  kind          EmailKind
  status        EmailLogStatus
  recipient     String // "to" address
  subject       String
  templateName  String?
  messageId     String? // nodemailer info.messageId on success
  error         String? // full error message/stack on failure
  subjectUserId String? // the employee the mail is ABOUT (null for HR digest)
  contextDate   DateTime?      @db.Date // the working day being reported
  dedupeKey     String?        @unique // e.g. "checkin-missing:emp:<userId>:2026-07-15"
  metadata      Json? // extra detail (SMTP response, absentee count, etc.)
  createdAt     DateTime       @default(now())
  subjectUser   User?          @relation("EmailLogSubjectUser", fields: [subjectUserId], references: [id])

  @@index([kind])
  @@index([status])
  @@index([subjectUserId])
  @@index([contextDate])
  @@index([createdAt])
}

// ─── Todo List / Personal Activities ────────────────────────────────────────
// Personal to-do items a user creates for themselves and/or other members.
// Only the creator may act on one (postpone / complete / cancel); assignees get
// a read-only view plus notifications.

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityActionType {
  CREATED
  POSTPONED
  COMPLETED
  CANCELLED
  SERIES_CANCELLED
  REMARK_ADDED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurrenceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Activity {
  id            String         @id @default(uuid())
  name          String
  description   String?
  createdById   String
  // Full date+time so a single range query drives every list and filter. When
  // allDay is set the times are normalised to the day's bounds.
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean        @default(false)
  status        ActivityStatus @default(PENDING)
  postponeCount Int            @default(0)
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Set when the row was generated from a recurring series. Null for one-off
  // activities, which behave exactly as they did before recurrence existed.
  recurrenceId   String?
  // Date-only anchor of the occurrence within its series. Paired with
  // recurrenceId it is the idempotency key that makes generation re-runnable.
  occurrenceDate DateTime?

  createdBy  User                @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  recurrence ActivityRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  assignees  ActivityAssignee[]
  actions    ActivityAction[]

  @@unique([recurrenceId, occurrenceDate])
  @@index([createdById])
  @@index([status])
  @@index([startAt])
  @@index([recurrenceId])
}

model ActivityAssignee {
  activityId String
  userId     String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
  @@index([userId])
}

model ActivityAction {
  id          String             @id @default(uuid())
  activityId  String
  actorId     String
  type        ActivityActionType
  fromStartAt DateTime?
  fromEndAt   DateTime?
  toStartAt   DateTime?
  toEndAt     DateTime?
  remarks     String?
  createdAt   DateTime           @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actor    User     @relation("ActivityActionActor", fields: [actorId], references: [id])

  @@index([activityId])
  @@index([actorId])
}

// ─── Recurring Todo Series ───────────────────────────────────────────────────
// A rule that materialises real Activity rows. Occurrences are generated ahead
// to a rolling horizon rather than computed on read, so every existing query,
// action and audit trail keeps working on a per-occurrence basis unchanged.

model ActivityRecurrence {
  id          String  @id @default(uuid())
  name        String
  description String?
  createdById String

  frequency   RecurrenceFrequency
  interval    Int                 @default(1) // every N days / weeks / months
  byWeekday   Int[]               @default([]) // WEEKLY only: 0=Sun … 6=Sat
  byMonthDay  Int? // MONTHLY only: 1–31, clamped to the last day of short months
  byMonthDays Int[]               @default([]) // MONTHLY only: multiple days (1–31)

  // Template window. The date part seeds the first occurrence; the time part and
  // duration are copied onto every occurrence the rule generates.
  seriesStartAt  DateTime
  durationMin    Int
  allDay         Boolean   @default(false)
  seriesEndDate  DateTime? // null together with maxOccurrences = open-ended
  maxOccurrences Int?

  // Skips Saturdays, Sundays and non-optional public holidays. Skipped days are
  // dropped, not shifted, and never count against maxOccurrences.
  skipNonWorkingDays Boolean @default(false)

  status          RecurrenceStatus @default(ACTIVE)
  // Horizon watermark — occurrences exist up to this instant. The daily cron
  // extends it; nothing else may move it backwards.
  generatedUntil  DateTime?
  occurrenceCount Int              @default(0)
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy  User                         @relation("ActivityRecurrenceCreatedBy", fields: [createdById], references: [id])
  assignees  ActivityRecurrenceAssignee[]
  activities Activity[]

  @@index([createdById])
  @@index([status, generatedUntil])
}

model ActivityRecurrenceAssignee {
  recurrenceId String
  userId       String
  createdAt    DateTime @default(now())

  recurrence ActivityRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([recurrenceId, userId])
  @@index([userId])
}
