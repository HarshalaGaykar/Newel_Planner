// ── WORKFLOW ENGINE ───────────────────────────────────────────────────────────

enum WorkflowAction {
  APPROVE
  REJECT
  SEND_BACK
  DELEGATE
  ESCALATE
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApproverType {
  ROLE
  USER
  REPORTING_AUTHORITY
}

model WorkflowTemplate {
  id        String             @id @default(uuid())
  module    String // LEAVE, TIMESHEET, DEMAND, PROJECT, CR, ALLOCATION_OVERRIDE
  name      String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  steps     WorkflowStep[]
  instances WorkflowInstance[]
}

model WorkflowStep {
  id                 String           @id @default(uuid())
  templateId         String
  stepOrder          Int
  stepName           String
  approverType       ApproverType     @default(ROLE)
  approverRoleId     String? // if type = ROLE
  approverUserId     String? // if type = USER
  escalateAfterHours Int? // null = no auto-escalation
  allowDelegate      Boolean          @default(true)
  template           WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepOrder])
}

model WorkflowInstance {
  id          String              @id @default(uuid())
  templateId  String
  entityType  String // LEAVE, TIMESHEET, DEMAND, PROJECT, CR
  entityId    String
  currentStep Int                 @default(1)
  status      WorkflowStatus      @default(PENDING)
  requesterId String
  remarks     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  template    WorkflowTemplate    @relation(fields: [templateId], references: [id])
  requester   User                @relation("WorkflowRequester", fields: [requesterId], references: [id])
  actions     WorkflowActionLog[]
}

model WorkflowActionLog {
  id          String           @id @default(uuid())
  instanceId  String
  stepOrder   Int
  actorId     String
  action      WorkflowAction
  remarks     String?
  delegatedTo String?
  takenAt     DateTime         @default(now())
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor       User             @relation("WorkflowActor", fields: [actorId], references: [id])
}

model Freelancer {
